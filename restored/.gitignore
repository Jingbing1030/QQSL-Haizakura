# --- build / runtime residue (regenerated by scripts/build.mjs and by running the bundle) ---
logs/
streams/
config/
dist/index.mjs.ref
reference/.pristine-source.stamp.json

# --- generated bundle (rebuild with: node scripts/build.mjs) ---
